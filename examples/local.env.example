# マシン共通の設定サンプル。~/.config/req2pr/local.env にコピーして使う。
# API キーはここに書かず、シェルの環境変数（ANTHROPIC_API_KEY）で渡すこと。

# LMSTUDIO_BASE_URL="http://127.0.0.1:1234/v1"
# LOCAL_MODEL_ID="qwen/qwen3-coder-30b"
# LOCAL_CONTEXT_LENGTH=65536
# PLANNER_MODEL="anthropic/claude-opus-5-5"
# REVIEWER_MODEL="anthropic/claude-sonnet-5-5"
# NOTIFY_CMD="terminal-notifier -title req2pr -message"
# PLAYWRIGHT_BROWSER="chrome"              # chrome | msedge | firefox | webkit
# OPENCODE_RUN_FLAGS="--standalone --format json"
# OPENCODE_CONFIG_MODE="env"               # 設定が読まれない場合は "dotdir"
